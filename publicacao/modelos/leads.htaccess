# ALFA PREV — publicacao/modelos/leads.htaccess
#
# >>> SUPERADO em out/2026 — NÃO usar isoladamente. <<<
# O conteúdo abaixo já está embutido em publicacao/modelos/.htaccess (bloco
# <FilesMatch "^leads\.html$"> dentro do BLOCO 1), que é copiado automaticamente
# para a raiz do pacote por "npm run empacotar". Este arquivo foi criado numa
# sessão anterior (antes do empacotamento consolidado existir) e é mantido
# apenas como referência histórica isolada do reforço de headers do /leads —
# não precisa ser copiado manualmente para lugar nenhum. Se algum dia o
# .htaccess principal for descontinuado, use este arquivo como base para
# recriar a proteção de /leads, mas hoje ele é redundante.
#
# Descrição original (ainda válida como referência de conteúdo):
# Modelo de configuração Apache para reforçar, via header HTTP, as mesmas
# proteções já aplicadas em netlify.toml e na <meta http-equiv="Content-Security-Policy">
# de src/pages/leads.html.

<IfModule mod_headers.c>
  <FilesMatch "^leads\.html$">
    Header set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self' https://*.supabase.co; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Referrer-Policy "no-referrer"
    Header set Cache-Control "no-store"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
  </FilesMatch>
</IfModule>
